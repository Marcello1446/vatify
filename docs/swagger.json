{
    "swagger": "2.0",
    "info": {
        "description": "VATify is a reliable EU VAT number validation API. It wraps the official VIES service with caching, audit logging, and tiered API key access.",
        "title": "VATify API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/v1",
    "paths": {
        "/keys": {
            "post": {
                "description": "Generates API key based on plan",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Generates API key based on plan",
                "parameters": [
                    {
                        "description": "Login and email",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.Login"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponses"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponses"
                        }
                    }
                }
            }
        },
        "/usage": {
            "get": {
                "description": "Gets already used requests, plan and limit",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Gets already used requests, plan and limit",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.UsageResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/validate": {
            "post": {
                "description": "Gets VAT and Country Code",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Gets VAT and Country Code",
                "parameters": [
                    {
                        "description": "VAT and country code",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.Request"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.Response"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "handler.ErrorResponses": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "handler.Login": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "plan": {
                    "type": "string"
                }
            }
        },
        "handler.Request": {
            "type": "object",
            "required": [
                "country_code",
                "vat"
            ],
            "properties": {
                "country_code": {
                    "type": "string"
                },
                "vat": {
                    "type": "string",
                    "maxLength": 13,
                    "minLength": 8
                }
            }
        },
        "handler.Response": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "country_code": {
                    "type": "string"
                },
                "is_valid": {
                    "type": "boolean"
                },
                "trade_name": {
                    "type": "string"
                },
                "vat": {
                    "type": "string"
                }
            }
        },
        "handler.UsageResponse": {
            "type": "object",
            "properties": {
                "plan": {
                    "type": "string"
                },
                "request_limit": {
                    "type": "integer"
                },
                "requests_used": {
                    "type": "integer"
                }
            }
        }
    }
}